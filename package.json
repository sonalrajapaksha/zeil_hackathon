{
  "name": "access-zeil-hackathon-starter",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:gemini": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tests/gemini-smoke.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:redesign-browser": "node tests/redesign-browser.mjs",
    "test:voice-canvas-browser": "node tests/voice-canvas-browser.mjs",
    "test:voice-profile-gemini": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tests/voice-profile-gemini-smoke.ts",
    "test:live-browser": "node tests/live-browser.mjs",
    "test:live-gemini": "node --env-file-if-exists=.env --env-file-if-exists=.env.local tests/live-gemini-smoke.ts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
