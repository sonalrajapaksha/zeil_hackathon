# Required for real AI functionality, server side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Choose a Gemini model your own API account can access. Do not commit .env.local.
# Optional Task 13 stretch mode. Off by default; text always remains complete.
# Enable only after checking Live model access and platform quota/rate limits.
GEMINI_LIVE_ENABLED=false
GEMINI_LIVE_MODEL=gemini-3.8-live
